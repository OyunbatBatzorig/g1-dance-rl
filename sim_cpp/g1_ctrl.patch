--- a/main.cpp
+++ b/main.cpp
@@ -1,3 +1,5 @@
+#include <map>
+#include <cstdlib>
 #include "FSM/CtrlFSM.h"
 #include "FSM/State_Passive.h"
 #include "FSM/State_FixStand.h"
@@ -51,6 +53,26 @@
     std::cout << "Press [L2 + Up] to enter FixStand mode.\n";
     std::cout << "And then press [R1 + X] to start controlling the robot.\n";
 
+    // g1_pilot: PAD_LOG=1 prints every remote button change (to see what reaches g1_ctrl, e.g. for LT(2s) combos)
+    if(std::getenv("PAD_LOG")) {
+        auto & j = FSMState::lowstate->joystick;
+        std::map<std::string, bool> last;
+        bool lt_long = false;
+        while (true)
+        {
+            std::map<std::string, bool> now = {
+                {"L2(LT)", j.LT.pressed}, {"R2(RT)", j.RT.pressed}, {"L1(LB)", j.LB.pressed}, {"R1(RB)", j.RB.pressed},
+                {"up", j.up.pressed}, {"down", j.down.pressed}, {"left", j.left.pressed}, {"right", j.right.pressed},
+                {"A", j.A.pressed}, {"B", j.B.pressed}, {"X", j.X.pressed}, {"Y", j.Y.pressed}};
+            for(auto & [k, v] : now) {
+                if(last.count(k) && last[k] != v) { spdlog::info("[pad] {} {}", k, v ? "pressed" : "released"); }
+            }
+            if(j.LT.pressed && j.LT.pressed_time >= 2.0f && !lt_long) { spdlog::info("[pad] L2 held 2 s: now press up / right"); lt_long = true; }
+            if(!j.LT.pressed) { lt_long = false; }
+            last = now;
+            usleep(2000);
+        }
+    }
     while (true)
     {
         sleep(1);
