+// scripted test (g1_pilot): KB_SCRIPT="t:key[xN],..." presses keys at wall-clock seconds after start, e.g.
+// "3:1,6:8x22,9:2,11:9,14:3"; KB_LOG=1 prints sim time, pelvis height and torso tilt every 0.5 s.
+void ScriptThread()
+{
+  const char* script = std::getenv("KB_SCRIPT");
+  const bool log = std::getenv("KB_LOG") != nullptr;
+  auto t0 = std::chrono::steady_clock::now();
+  std::vector<std::tuple<double, int, int>> events;
+  if(script) {
+    std::stringstream ss(script);
+    std::string item;
+    while(std::getline(ss, item, ',')) {
+      auto c = item.find(':');
+      double t = std::stod(item.substr(0, c));
+      std::string k = item.substr(c + 1);
+      int n = 1;
+      auto x = k.find('x');
+      if(x != std::string::npos) { n = std::stoi(k.substr(x + 1)); k = k.substr(0, x); }
+      int key = (k == "up") ? GLFW_KEY_UP : (k == "down") ? GLFW_KEY_DOWN : int(k[0]);
+      events.emplace_back(t, key, n);
+    }
+  }
+  size_t next = 0;
+  double next_log = 0.5;
+  while(true) {
+    double t = std::chrono::duration<double>(std::chrono::steady_clock::now() - t0).count();
+    while(next < events.size() && std::get<0>(events[next]) <= t) {
+      for(int i = 0; i < std::get<2>(events[next]); ++i) { handle_key(std::get<1>(events[next])); }
+      ++next;
+    }
+    if(log && d && t >= next_log) {
+      double w = d->qpos[3], x = d->qpos[4], y = d->qpos[5];
+      double tilt = std::acos(std::clamp(1.0 - 2.0 * (x * x + y * y), -1.0, 1.0)) * 180.0 / M_PI;
+      (void)w;
+      std::printf("[log] wall %.1f s  sim %.2f s  pelvis z %.3f m  tilt %.1f deg  band %s %.1f m\n", t, d->time,
+                  d->qpos[2], tilt, elastic_band.enable_ ? "on" : "off", elastic_band.length_);
+      std::fflush(stdout);
+      next_log += 0.5;
     }
+    std::this_thread::sleep_for(std::chrono::milliseconds(10));
   }
 }
 
