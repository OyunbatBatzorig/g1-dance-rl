+// Keyboard "gamepad" (g1_pilot): a key starts a short button macro, e.g. LT held 2.6 s then right pressed,
+// so the deploy FSM sees the same combos as from a real pad. See keyboard_macro() in main.cc for the keys.
+#include <chrono>
+#include <mutex>
+
+class KeyboardJoystick : public unitree::common::UnitreeJoystick
+{
+public:
+    struct Macro { bool lt = false, rb = false; std::string key; double key_at = 0.4, end = 0.7; };
+
+    void play(const Macro & m)
+    {
+        std::lock_guard<std::mutex> lock(mu_);
+        macro_ = m;
+        t0_ = std::chrono::steady_clock::now();
+        active_ = true;
+    }
+
+    void update() override
+    {
+        std::lock_guard<std::mutex> lock(mu_);
+        double t = std::chrono::duration<double>(std::chrono::steady_clock::now() - t0_).count();
+        if(active_ && t > macro_.end) { active_ = false; }
+        bool k = active_ && t >= macro_.key_at;
+        LT(active_ && macro_.lt ? 1.0f : 0.0f);
+        RB(active_ && macro_.rb ? 1 : 0);
+        up(k && macro_.key == "up");
+        down(k && macro_.key == "down");
+        left(k && macro_.key == "left");
+        right(k && macro_.key == "right");
+        A(k && macro_.key == "A");
+        B(k && macro_.key == "B");
+        X(k && macro_.key == "X");
+        Y(k && macro_.key == "Y");
+        back(0); start(0); LB(0); RT(0.0f);
+        lx(0.0f); ly(0.0f); rx(0.0f); ry(0.0f);
+    }
+
+private:
+    std::mutex mu_;
+    Macro macro_;
+    bool active_ = false;
+    std::chrono::steady_clock::time_point t0_;
+};
+
+inline std::shared_ptr<KeyboardJoystick> keyboard_joystick;
