+// keyboard gamepad (g1_pilot): number keys play the gamepad combos of the deploy FSM (config.yaml of g1_ctrl)
+//   1 = LT + up          Passive -> FixStand
+//   2 = RB + X           FixStand -> Velocity
+//   3 = LT(2s) + up      Velocity -> Mimic_Schuhplattler_ArmTest
+//   4 = LT(2s) + right   Velocity -> Mimic_Schuhplattler
+//   0 = LT + B           any -> Passive (damping)
+void keyboard_macro(int key)
+{
+  if(!keyboard_joystick) { return; }
+  KeyboardJoystick::Macro mc;
+  if(key == GLFW_KEY_1) { mc.lt = true; mc.key = "up"; }
+  else if(key == GLFW_KEY_2) { mc.rb = true; mc.key = "X"; }
+  else if(key == GLFW_KEY_3) { mc.lt = true; mc.key = "up"; mc.key_at = 2.6; mc.end = 2.9; }
+  else if(key == GLFW_KEY_4) { mc.lt = true; mc.key = "right"; mc.key_at = 2.6; mc.end = 2.9; }
+  else if(key == GLFW_KEY_0) { mc.lt = true; mc.key = "B"; }
+  else { return; }
+  std::cout << "[keyboard pad] key " << char(key) << " -> " << (mc.lt ? (mc.key_at > 1 ? "LT(2s) + " : "LT + ") : "RB + ")
+            << mc.key << std::endl;
+  keyboard_joystick->play(mc);
+}
+
+void handle_key(int key)
+{
+  if(key >= GLFW_KEY_KP_0 && key <= GLFW_KEY_KP_9) { key = GLFW_KEY_0 + (key - GLFW_KEY_KP_0); }  // numpad = number row
+  if(param::config.enable_elastic_band == 1) {
+    if (key==GLFW_KEY_9) {
+      elastic_band.enable_ = !elastic_band.enable_;
+      std::cout << "[keyboard pad] key 9 -> elastic band " << (elastic_band.enable_ ? "ON" : "OFF") << std::endl;
+    } else if (key==GLFW_KEY_7 || key==GLFW_KEY_UP) {
+      elastic_band.length_ -= 0.1;
+      std::cout << "[keyboard pad] band up, length " << elastic_band.length_ << " m" << std::endl;
+    } else if (key==GLFW_KEY_8 || key==GLFW_KEY_DOWN) {
+      elastic_band.length_ += 0.1;
+      std::cout << "[keyboard pad] band down, length " << elastic_band.length_ << " m (0.5 = feet on the floor)" << std::endl;
+    }
+  }
+  if(key==GLFW_KEY_BACKSPACE) {
+    mj_resetData(m, d);
+    mj_forward(m, d);
+  }
+  keyboard_macro(key);
+}
